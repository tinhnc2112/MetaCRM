# Meta / Facebook Page access token (do not commit real secrets)
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Token used by Meta webhook verification
VERIFY_TOKEN=your_verify_token_here

# OpenAI API key (do not commit real secrets)
OPENAI_API_KEY=your_openai_api_key_here

# Database connection string
DATABASE_URL=sqlite:///./metacrm.db

# OpenAI model used by the AI Sale BOT
OPENAI_MODEL=gpt-4o-mini
