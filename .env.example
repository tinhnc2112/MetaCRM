# Application
APP_NAME=MetaCRM API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security: replace this with a long, cryptographically random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=mysql+pymysql://metacrm:change-me@localhost:3306/metacrm?charset=utf8mb4
DATABASE_ECHO=false

# Comma-separated origins. Do not use * when allowing credentials in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Facebook / Meta
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/facebook/auth/callback
FACEBOOK_API_VERSION=v25.0
FACEBOOK_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key-or-long-random-secret
FACEBOOK_DESKTOP_REDIRECT_URI=metacrm://settings/facebook

# Paths are relative to the project root unless absolute.
UPLOAD_DIR=backend/uploads
LOG_DIR=backend/logs
LOG_LEVEL=INFO
